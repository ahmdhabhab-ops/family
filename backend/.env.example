# Copy this to .env (or set these as environment variables in Dokploy).

# Postgres connection string for your existing self-hosted Postgres.
# Create a fresh database for this app first, e.g.: createdb family
DATABASE_URL=postgres://user:password@host:5432/family
# Set to "true" only if your Postgres requires SSL.
PGSSL=false

# Any long random string — used to sign session tokens. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

PORT=4000

# Web Push (VAPID) — new key pair generated for this migration (the old
# private key only ever lived in Supabase's edge function secrets and
# couldn't be recovered, so everyone will need to re-enable push once
# after switching over).
VAPID_PUBLIC_KEY=BKnSSCdrNjqgGLeyxNG4D3ZF8HedfHfo3Dverq5JpXejmJUbD6r0ifYf1FFgLUGXDdNGnYnh1dUy5dpGoDXZGGA
VAPID_PRIVATE_KEY=jdK0L4E-qloeKyKqXghJR8Xm5zfC51tfs-Lrkdez73M
VAPID_SUBJECT=mailto:admin@example.com
